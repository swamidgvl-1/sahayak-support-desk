# ---- Required ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. NEVER prefix with NEXT_PUBLIC_. Needed for "Create user" / CSV import in Admin.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your live site address (used in email/push links). Example: https://sahayak.vercel.app
NEXT_PUBLIC_SITE_URL=
# Set to true only after you enable Google sign-in in Supabase
NEXT_PUBLIC_GOOGLE_ENABLED=false

# ---- Branding (optional) ----
NEXT_PUBLIC_APP_NAME=Sahayak
NEXT_PUBLIC_ORG_NAME=Your College

# ---- Optional: scheduled sweep (auto-close + SLA overdue) ----
CRON_SECRET=make-up-a-long-random-string

# ---- Optional: email + push notifications (see GUIDE.md part 9) ----
RESEND_API_KEY=
EMAIL_FROM="Sahayak <support@yourdomain.com>"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourcollege.edu
